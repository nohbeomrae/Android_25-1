<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">


    <!-- https://recipes4dev.tistory.com/158   -->
    <TextView
        android:id="@+id/screen_title_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그인"
        android:textColor="#000000"
        android:textSize="25sp"
        android:layout_marginTop="150sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />



    <EditText
        android:id="@+id/login_id_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="아이디"
        android:layout_marginTop="100sp"
        app:layout_constraintTop_toBottomOf="@+id/screen_title_login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <EditText
        android:id="@+id/login_password_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="비밀번호"
        app:layout_constraintTop_toBottomOf="@+id/login_id_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/button_login_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그인"
        app:layout_constraintTop_toBottomOf="@+id/login_password_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/button_login_kakao_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_logo_kakao"
        app:layout_constraintTop_toBottomOf="@+id/button_login_button"
        app:layout_constraintStart_toEndOf="@+id/button_login_naver_button"

    />

    <ImageView
        android:id="@+id/button_login_naver_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@+id/button_login_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_logo_naver"
        />

    <ImageView
        android:id="@+id/button_login_google_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_logo_google"
        app:layout_constraintEnd_toStartOf="@+id/button_login_naver_button"
        app:layout_constraintTop_toBottomOf="@+id/button_login_button"
        />


    <!--  이 부분은 constraint layout으로 어떻게 해결 할지 모르겠습니다.-->
    <!--  TextView 비밀번호 찾기와 가입하기를 하나로 합침-->
    <TextView
        android:id="@+id/text_links"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 찾기   가입하기"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="16dp"
        app:layout_constraintTop_toBottomOf="@+id/button_login_naver_button" />


</androidx.constraintlayout.widget.ConstraintLayout>