<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    >

<!--https://recipes4dev.tistory.com/126-->

    <TextView
        android:id="@+id/screen_title_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그인"
        android:textSize="25sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:textColor="#000000"/>


    <EditText
        android:id="@+id/login_id_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/screen_title_login"
        android:layout_marginTop="150dp"
        android:hint="아이디"/>

    <EditText
        android:id="@+id/login_password_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/login_id_edit"
        android:hint="비밀번호"/>

    <Button
        android:id="@+id/button_login_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/login_password_edit"
        android:text="로그인"
        android:layout_centerHorizontal="true"
        />


    <ImageView
        android:id="@+id/button_login_google_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_below="@+id/button_login_button"
        android:layout_toLeftOf="@+id/button_login_naver_button"
        android:contentDescription="구글 로그인"
        android:src="@drawable/ic_logo_google"
        android:layout_marginEnd="8dp"/>

    <ImageView
        android:id="@+id/button_login_naver_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_below="@+id/button_login_button"
        android:layout_centerHorizontal="true"
        android:contentDescription="네이버 로그인"
        android:src="@drawable/ic_logo_naver"
        android:layout_marginEnd="8dp"/>


    <ImageView
        android:id="@+id/button_login_kakao_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_below="@+id/button_login_button"
        android:layout_toRightOf="@+id/button_login_naver_button"
        android:layout_centerHorizontal="true"
        android:contentDescription="네이버 로그인"
        android:src="@drawable/ic_logo_kakao"
        android:layout_marginEnd="8dp"/>


<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_below="@+id/button_login_naver_button"
    android:layout_centerHorizontal="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/button_findpassword_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 찾기"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/button_joinmembership_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입" />
</LinearLayout>

</RelativeLayout>

